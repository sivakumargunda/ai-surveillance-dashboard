# FastAPI / deployment
ENV=production
PORT=8000
CORS_ORIGINS=https://your-frontend-domain.com
AUTO_START_CAMERAS=false
DATABASE_URL=sqlite:///./artifacts/surveillance.db

# Camera input
# Use 0 for a local webcam, a local video path for demo, or an RTSP/HTTP URL.
VIDEO_SOURCE=0
MULTI_CAM_URLS=
CAMERA_REGISTRY_PATH=artifacts/cameras.json

# AI model
YOLO_MODEL=yolov8n.onnx
YOLO_DEVICE=cpu
YOLO_CONFIDENCE=0.45
FRAME_SKIP=2
SHOW_WINDOW=false

# Runtime artifacts
ALERT_SCREENSHOT_DIR=artifacts/alerts
CLIP_DIR=artifacts/clips
ENABLE_ZONE_CLIPS=true

# React build-time configuration
REACT_APP_API_BASE_URL=https://your-api-domain.com
